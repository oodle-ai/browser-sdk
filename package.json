{
  "name": "@oodle-ai/rum",
  "version": "0.5.0",
  "description": "Oodle Real User Monitoring SDK",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/oodle-ai/browser-sdk"
  },
  "type": "module",
  "main": "./dist/oodle-rum.cjs",
  "module": "./dist/oodle-rum.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/oodle-rum.js",
      "require": "./dist/oodle-rum.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-web": "^0.68.0",
    "@opentelemetry/context-zone": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-web": "^2.12.0",
    "fflate": "^0.8.2",
    "rrweb": "2.1.1",
    "web-vitals": "^4.2.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^4.1.10"
  }
}
